  "schema_version": 13,
  "default_lexicon": "en-sims",
  "exception_rules": [
    {
      "id": "ts4_store_utils_wallet_ui",
      "title": "StoreUtils / VirtualCurrencyWallet UI Desync (Error #1006)",
      "enabled": true,
      "pattern": "StoreUtils/StoreDisabledByFeatureParameter | VirtualCurrencyWallet | TryGetValueAsBoolean",
      "severity": "warning",
      "diagnosis": "ActionScript UI exception in widgets.shared.utils::StoreUtils / VirtualCurrencyWallet. Frequently triggered on the Main Menu when EA Store feature parameters fail to initialize, or when an outdated UI override (.package) conflicts with current game patch UI widgets.",
      "file_hint": "lastUIException.txt",
      "resolution": "If this occurred on the Main Menu and live gameplay UI works normally, it is often a benign EA Store telemetry quirk (you can toggle 'Ignore During Timed Lab Verification' on this rule if desired). If UI panels are broken in live mode, ensure UI Cheats Extension (.package + .ts4script) and Main Menu overrides match your current game patch.",
      "ignore_in_lab": false
    },
    {
      "id": "ts4_vanilla_milestone_tracker",
      "title": "Vanilla Milestone / Infant Tracker Desync (Base Game Bug)",
      "enabled": true,
      "pattern": "developmental_milestone_tracker | milestone_tracker",
      "severity": "unrelated",
      "diagnosis": "Normal EA Base Game bug in developmental_milestone_tracker when switching households or loading lots with infants/toddlers whose milestone state became desynchronized in an unmodded save.",
      "file_hint": "lastException.txt",
      "resolution": "Not caused by a custom mod. Marked as Unrelated (Normal Game Bug) so it will not auto-fail Lab Proving Runs.",
      "ignore_in_lab": true
    },
    {
      "id": "ts4_python_attr_or_import",
      "title": "Python Script Tuning Mismatch or Missing Core Library",
      "enabled": true,
      "pattern": "AttributeError | ModuleNotFoundError | ImportError",
      "severity": "critical",
      "diagnosis": "A Python script (.ts4script) attempted to call a game engine attribute or import a module that changed in a recent game patch or requires an external core library (such as Lot51 Core Library, XML Injector, or S4CL).",
      "file_hint": "lastException.txt",
      "resolution": "Verify that all required dependency libraries are installed in your Mods folder and that the mod's .ts4script is updated for your active game patch.",
      "ignore_in_lab": false
    },
    {
      "id": "ts4_posture_routing_graph",
      "title": "Posture Graph / Sim Routing Autonomy Exception",
      "enabled": true,
      "pattern": "posture_graph | routing_service | PostureGraphService",
      "severity": "warning",
      "diagnosis": "A Sim attempted to route to or interact with an object whose footprint, slot, or posture tuning failed validation during live autonomy.",
      "file_hint": "lastException.txt",
      "resolution": "Check custom furniture/object overrides on the active lot or custom interaction mods that modify Sim posture tuning.",
      "ignore_in_lab": false
    }
  ],
  "executable_names": [
    "TS4_x64.exe",
    "TS4.exe",
    "TS4_DX9_x64.exe",
    "The Sims 4.app",
    "The Sims 4",
    "TS4_DX11.exe"
  ],
  "lab_verification": {
    "require_focus": true,
    "save_extensions": [
      ".save",
      ".ver0",
      ".ver1",
      ".ver2",
      ".ver3",
      ".ver4"
    ],
    "max_idle_seconds": 20,
    "pause_key_vk_codes": [
      192,
      48,
      96
    ],
    "resume_key_vk_codes": [
      49,
      50,
      51,
      97,
      98,
      99
    ],
    "world_load_signature": {
      "min_disk_read_mb": 75,
      "min_ram_step_percent": 25,
      "stabilize_boot_seconds": 16,
      "scratch_activity_subdirs": [
        "saves/scratch"
      ],
      "warm_cache_ram_step_percent": 45
    },
    "require_save_checkpoint": true,
    "required_active_seconds": 120,
    "require_for_mason_publish": true,
    "require_for_scout_approval": true,
    "enable_hotkey_pause_detection": true,
    "seed_sandbox_from_latest_save": true
  },
  "manifest_content": "Priority 500\nPackedFile *.package\nPackedFile */*.package\nPackedFile */*/*.package\nPackedFile */*/*/*.package\nPackedFile */*/*/*/*.package\nPackedFile */Delta/tmscenario1.tmdelta\nPackedFile Data/*Strings.tmcatalog\nPackedFile */Data/*Strings.tmcatalog\n\nPriority 1000\nPackedFile Sanctuary/*.package\nPackedFile Sanctuary/*/*.package\nPackedFile Sanctuary/*/*/*.package\n\nPriority 1500\nPackedFile Sanctuary2/*.package\nPackedFile Sanctuary2/*/*.package\nPackedFile Sanctuary2/*/*/*.package\n\nPriority 2000\nPackedFile Sanctuary3/*.package\nPackedFile Sanctuary3/*/*.package\nPackedFile Sanctuary3/*/*/*.package",
  "conflict_analyzers": [
    {
      "id": "binary_index_table",
      "type": "binary_chunk_index",
      "endian": "le",
      "key_size": 16,
      "entry_size": 32,
      "extensions": [
        ".package"
      ],
      "magic_bytes": "0x44425046",
      "header_offset": 0,
      "index_offset_pos": 64,
      "index_count_offset": 36,
      "bitmask_constant_header": true
    },
    {
      "id": "script_archive_members",
      "type": "archive_member",
      "extensions": [
        ".ts4script"
      ]
    }
  ],
  "version_extraction": {
    "method": "pe_header",
    "json_key": null,
    "line_prefix": "gameversion",
    "relative_path": "Game/Bin/Default.ini"
  },
  "dlc_file_extensions": [],
  "dlc_folder_prefixes": [
    "EP",
    "GP",
    "SP",
    "FP"
  ],
  "min_scout_submissions": 5,
  "launch_args_dlc_mask_template": "-disablepack:{packs}"
}
