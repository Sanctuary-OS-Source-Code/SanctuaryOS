{
  "id": "sims4",
  "game_id": "the-sims-4",
  "display_name": "The Sims 4",
  "default_lexicon": "en-default",
  "schema_version": 10,
  "min_scout_submissions": 5,
  "executable_names": [
    "TS4_x64.exe",
    "TS4.exe",
    "TS4_DX9_x64.exe",
    "The Sims 4.app",
    "The Sims 4"
  ],
  "paths": {
    "executable_subdir": "Game/Bin",
    "manifest_file": "Resource.cfg",
    "default_mod_dir_windows": "%USERPROFILE%/Documents/Electronic Arts/The Sims 4/Mods",
    "default_mod_dir_mac": "~/Documents/Electronic Arts/The Sims 4/Mods",
    "user_data_dir_windows": "%USERPROFILE%/Documents/Electronic Arts/The Sims 4",
    "user_data_dir_mac": "~/Documents/Electronic Arts/The Sims 4",
    "auto_scan_paths_windows": [
      "C:\\Program Files\\EA Games\\The Sims 4",
      "C:\\Program Files\\EA\\Origin Games\\The Sims 4\\Bin",
      "C:\\Program Files (x86)\\Origin Games\\The Sims 4\\Game\\Bin",
      "C:\\Program Files\\EA Games\\The Sims 4\\Game\\Bin",
      "D:\\Program Files\\EA Games\\The Sims 4",
      "D:\\Program Files\\EA\\Origin Games\\The Sims 4\\Bin",
      "D:\\Program Files (x86)\\Origin Games\\The Sims 4\\Game\\Bin",
      "D:\\Program Files\\EA Games\\The Sims 4\\Game\\Bin",
      "E:\\Program Files\\EA Games\\The Sims 4",
      "E:\\Program Files\\EA\\Origin Games\\The Sims 4\\Bin",
      "E:\\Program Files (x86)\\Origin Games\\The Sims 4\\Game\\Bin",
      "E:\\Program Files\\EA Games\\The Sims 4\\Game\\Bin",
      "F:\\Program Files\\EA Games\\The Sims 4",
      "F:\\Program Files\\EA\\Origin Games\\The Sims 4\\Bin",
      "F:\\Program Files (x86)\\Origin Games\\The Sims 4\\Game\\Bin",
      "F:\\Program Files\\EA Games\\The Sims 4\\Game\\Bin",
      "G:\\Program Files\\EA Games\\The Sims 4",
      "G:\\Program Files\\EA\\Origin Games\\The Sims 4\\Bin",
      "G:\\Program Files (x86)\\Origin Games\\The Sims 4\\Game\\Bin",
      "G:\\Program Files\\EA Games\\The Sims 4\\Game\\Bin",
      "C:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4\\Game\\Bin",
      "D:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4\\Game\\Bin",
      "E:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4\\Game\\Bin",
      "F:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4\\Game\\Bin",
      "G:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4\\Game\\Bin"
    ],
    "auto_scan_paths_mac": [
      "/Applications/The Sims 4.app",
      "/Applications/EA Games/The Sims 4.app",
      "~/Applications/The Sims 4.app",
      "~/Applications/EA Games/The Sims 4.app",
      "~/Library/Application Support/Origin/LocalContent/The Sims 4",
      "~/Library/Application Support/Steam/steamapps/common/The Sims 4/The Sims 4.app"
    ]
  },
  "extensions": {
    "supported": [
      ".package",
      ".ts4script",
      ".world",
      ".zip",
      ".rar",
      ".tmcatalog",
      ".cfg",
      ".tmdelta",
      ".tmbin",
      ".dat"
    ],
    "vault_visible": [
      ".package",
      ".ts4script",
      ".world",
      ".cfg",
      ".ini",
      ".json",
      ".txt",
      ".xml"
    ],
    "config_extensions": [
      ".cfg",
      ".ini",
      ".json",
      ".txt",
      ".xml"
    ],
    "ignore_unidentified": [
      ".cfg",
      ".ini",
      ".json",
      ".xml",
      ".log",
      ".txt",
      ".dat",
      ".tmbin",
      ".tmcatalog",
      ".tmdelta",
      ".jpg",
      ".png",
      ".pdf",
      ".md",
      ".html"
    ],
    "cache_files": [
      "localthumbcache.package",
      "avatarcache.package",
      "localsimtexturecache.package"
    ],
    "labels": {
      ".cfg": "CONFIG",
      ".rar": "ARCHIVE",
      ".zip": "ARCHIVE",
      ".package": "PACKAGE",
      ".tmdelta": "DELTA",
      ".tmcatalog": "CATALOG",
      ".ts4script": "SCRIPT",
      ".world": "WORLD"
    }
  },
  "constraints": {
    "max_folder_depth": 5,
    "requires_script_unzipping": false,
    "mods_dir_is_shared_with_vanilla": false,
    "preserve_archive_folder_structure": false,
    "wrap_loose_files_in_folders": true
  },
  "version_extraction": {
    "method": "pe_header",
    "relative_path": "Game/Bin/Default.ini",
    "line_prefix": "gameversion"
  },
  "dlc_folder_prefixes": [
    "EP",
    "GP",
    "SP",
    "FP"
  ],
  "dlc_subdirs": [
    "",
    "Delta",
    "The Sims 4 Packs"
  ],
  "dlc_file_extensions": [],
  "launch_args_dlc_mask_template": "-disablepack:{packs}",
  "manifest_content": "Priority 500\nPackedFile *.package\nPackedFile */*.package\nPackedFile */*/*.package\nPackedFile */*/*/*.package\nPackedFile */*/*/*/*.package\nPackedFile */Delta/tmscenario1.tmdelta\nPackedFile Data/*Strings.tmcatalog\nPackedFile */Data/*Strings.tmcatalog\n\nPriority 1000\nPackedFile Sanctuary/*.package\nPackedFile Sanctuary/*/*.package\nPackedFile Sanctuary/*/*/*.package\n\nPriority 1500\nPackedFile Sanctuary2/*.package\nPackedFile Sanctuary2/*/*.package\nPackedFile Sanctuary2/*/*/*.package\n\nPriority 2000\nPackedFile Sanctuary3/*.package\nPackedFile Sanctuary3/*/*.package\nPackedFile Sanctuary3/*/*/*.package",
  "load_order": {
    "strategy": "folder_priority",
    "direction": "higher_wins",
    "manifest_file": "Resource.cfg",
    "prefix_format": "{index:03}_",
    "line_template": "{file}",
    "priority_tiers": [
      {
        "id": "default",
        "label": "Standard (Base)",
        "priority": 500,
        "folder": ""
      },
      {
        "id": "tier_1",
        "label": "Tier 1 (Sanctuary)",
        "priority": 1000,
        "folder": "Sanctuary"
      },
      {
        "id": "tier_2",
        "label": "Tier 2 (Sanctuary2)",
        "priority": 1500,
        "folder": "Sanctuary2"
      },
      {
        "id": "tier_3",
        "label": "Tier 3 (Sanctuary3)",
        "priority": 2000,
        "folder": "Sanctuary3"
      }
    ]
  },
  "install_routes": [
    {
      "id": "world_areas",
      "label": "World Area Files (.world)",
      "extensions": [
        ".world"
      ],
      "folder_match": "Worlds",
      "target_root": "live_path",
      "target_subdir": "Data/Shared/Worlds/Areas",
      "preserve_vanilla": true
    }
  ],
  "exception_logs": [
    {
      "starts_with": "lastexception",
      "ends_with": ".txt"
    },
    {
      "starts_with": "lastuiexception",
      "ends_with": ".txt"
    },
    {
      "starts_with": "lastcleanexception",
      "ends_with": ".txt"
    },
    {
      "starts_with": "be-exceptionreport",
      "ends_with": ".html"
    },
    {
      "exact": "lastcrash.txt"
    },
    {
      "exact": "mc_lastexception.html"
    }
  ],
  "time_capsule": {
    "world_state_targets": [
      {
        "name": "Saves",
        "path": "Saves"
      },
      {
        "name": "Tray",
        "path": "Tray"
      },
      {
        "name": "ConfigOverride",
        "path": "ConfigOverride"
      },
      {
        "name": "Options.ini",
        "path": "Options.ini"
      }
    ],
    "engine_state_targets": [
      {
        "name": "Game",
        "path": "Game"
      },
      {
        "name": "Data",
        "path": "Data"
      },
      {
        "name": "Delta",
        "path": "Delta"
      }
    ],
    "save_airgap_targets": [
      "Saves",
      "saves"
    ]
  },
  "lab_verification": {
    "require_for_mason_publish": true,
    "require_for_scout_approval": true,
    "required_active_seconds": 120,
    "max_idle_seconds": 20,
    "require_focus": true,
    "require_save_checkpoint": true,
    "seed_sandbox_from_latest_save": true,
    "enable_hotkey_pause_detection": true,
    "save_extensions": [
      ".save",
      ".ver0",
      ".ver1",
      ".ver2",
      ".ver3",
      ".ver4"
    ],
    "world_load_signature": {
      "stabilize_boot_seconds": 8,
      "min_disk_read_mb": 75,
      "min_ram_step_percent": 25,
      "warm_cache_ram_step_percent": 45,
      "scratch_activity_subdirs": [
        "saves/scratch"
      ]
    }
  },
  "mod_categories": [
