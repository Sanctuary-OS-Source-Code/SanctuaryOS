{
  "id": "/",
  "name": "Sanctuary OS",
  "short_name": "Sanctuary OS",
  "description": "Your Unified Hub for community-driven game modifications, blueprints, and assets.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "scope_extensions": [
    { "type": "origin", "origin": "https://sanctuaryos.net" },
    { "type": "origin", "origin": "https://www.sanctuaryos.net" }
  ],
  "orientation": "any",
  "background_color": "#0e2244",
  "theme_color": "#1d2737",
  "categories": ["games", "utilities", "productivity"],
  "icons": [
    {
      "src": "/pwa-192x192.png?v=sovereign_v7",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png?v=sovereign_v7",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png?v=sovereign_v7",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
