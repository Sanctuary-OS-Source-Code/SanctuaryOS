{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanctuary OS",
  "version": "0.5.8",
  "identifier": "sanctuary-os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "width": 1800,
        "height": 1200,
        "minWidth": 1600,
        "minHeight": 1000,
        "resizable": true,
        "center": true,
        "title": "Sanctuary OS",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: http://asset.localhost https: http: data: blob:; connect-src 'self' ipc: http://ipc.localhost https: wss: ws: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/nsis/sidebar.bmp",
        "headerImage": "icons/nsis/header.bmp"
      },
      "wix": {
        "bannerPath": "icons/wix_banner.bmp",
        "dialogImagePath": "icons/wix_dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "endpoints": [
        "https://github.com/Sanctuary-OS-Source-Code/SanctuaryOS/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NEY5MjZCM0Y4MkUzOTMKUldTVDQ0SS9hNUpQRlpWV09HVDJRQmEzQnpCUGpwMDlYU0hBczlGWmJDS3R5cXVMM29KV0RjUmsK"
    }
  }
}
